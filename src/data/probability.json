      "objective": "Locate impossible, unlikely, even-chance, likely and certain events on a zero-to-one scale.",
      "prerequisites": [
        "Count small quantities and read the mathematical symbols used here."
      ],
      "curriculum": [
        {
          "provider": "AQA",
          "reference": "P3",
          "title": "GCSE Mathematics 8300 — Probability",
