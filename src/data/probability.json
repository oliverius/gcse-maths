        }
      ],
      "tutorNotes": {
        "observe": "Pause after each change. Ask the student to explain the picture before continuing.",
        "misconception": "Likely means certain, or unlikely means impossible.",
        "checkQuestion": "What is the difference between likely and certain?"
      },
      "model": {},
