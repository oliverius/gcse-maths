      "model": {
        "total": 360,
        "angles": [
          140,
          90,
          130
        ]
      },
      "steps": [
        {
          "title": "Start with the first angle",
          "left": [
            {
              "id": "expression",
              "text": "one hundred and forty degrees",
              "latex": "140^{\\circ}",
              "spoken": "one hundred and forty degrees",
              "tone": "original"
            }
          ],
          "right": [],
          "balance": null,
          "explanation": "The first angle covers part of a full turn.",
          "detail": "",
          "operation": {
            "type": "show"
          },
          "scene": {
            "total": 360,
            "sectors": [
              {
                "id": "first",
                "start": 0,
                "end": 140,
                "known": true,
                "tone": "original"
              }
            ],
            "description": "A one hundred and forty degree sector."
          }
        },
        {
          "title": "Add the next angle",
          "left": [
            {
              "id": "expression",
              "text": "one hundred and forty plus ninety equals two hundred and thirty degrees",
              "latex": "140^{\\circ}+90^{\\circ}=230^{\\circ}",
              "spoken": "one hundred and forty plus ninety equals two hundred and thirty degrees",
              "tone": "original"
            }
          ],
          "right": [],
          "balance": null,
          "explanation": "A right angle adds ninety degrees. Together the known angles cover two hundred and thirty degrees.",
          "detail": "",
          "operation": {
            "type": "replace"
          },
          "scene": {
            "total": 360,
            "sectors": [
              {
                "id": "first",
                "start": 0,
                "end": 140,
                "known": true,
                "tone": "original"
              },
              {
                "id": "second",
                "start": 140,
                "end": 230,
                "known": true,
                "tone": "operation"
              }
            ],
            "description": "The two known sectors total two hundred and thirty degrees."
          },
          "highlight": [
            "expression"
          ]
        },
        {
          "title": "Complete the full turn",
          "left": [
            {
              "id": "expression",
              "text": "three hundred and sixty minus two hundred and thirty equals one hundred and thirty degrees",
              "latex": "360^{\\circ}-230^{\\circ}=130^{\\circ}",
              "spoken": "three hundred and sixty minus two hundred and thirty equals one hundred and thirty degrees",
              "tone": "original"
            }
          ],
          "right": [],
          "balance": null,
          "explanation": "The remaining angle is one hundred and thirty degrees. The three angles make a full turn.",
          "detail": "",
          "operation": {
            "type": "simplify"
          },
          "scene": {
            "total": 360,
            "sectors": [
              {
                "id": "first",
                "start": 0,
                "end": 140,
                "known": true,
                "tone": "original"
              },
              {
                "id": "second",
                "start": 140,
                "end": 230,
                "known": true,
                "tone": "operation"
              },
              {
                "id": "rest",
                "start": 230,
                "end": 360,
                "known": true,
                "tone": "operation"
              }
            ],
            "description": "Angles of one hundred and forty, ninety and one hundred and thirty degrees make three hundred and sixty degrees."
          },
          "highlight": [
            "expression"
          ]
        }
      ]
