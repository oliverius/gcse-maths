          "scene": {
            "shape": "rectangle",
            "width": 5,
            "height": 3,
            "description": "1 complete rows of five shaded unit squares.",
            "grid": true,
            "rows": 1
          },
          "highlight": [
            "expression"
          ]
        },
        {
          "title": "Fill row 2",
          "left": [
            {
              "id": "expression",
              "text": "2 times five equals 10",
              "latex": "2\\times5=10",
              "spoken": "2 times five equals 10",
              "tone": "original"
            }
          ],
          "right": [],
          "balance": null,
          "explanation": "Each row contains five unit squares. 2 rows cover 10 square units.",
          "detail": "",
          "operation": {
            "type": "partition"
          },
          "scene": {
            "shape": "rectangle",
            "width": 5,
            "height": 3,
            "description": "2 complete rows of five shaded unit squares.",
            "grid": true,
            "rows": 2
          },
          "highlight": [
            "expression"
          ]
        },
        {
          "title": "Fill row 3",
          "left": [
            {
              "id": "expression",
              "text": "3 times five equals 15",
              "latex": "3\\times5=15",
              "spoken": "3 times five equals 15",
              "tone": "original"
            }
          ],
          "right": [],
          "balance": null,
          "explanation": "Each row contains five unit squares. 3 rows cover 15 square units.",
          "detail": "",
          "operation": {
            "type": "partition"
          },
          "scene": {
            "shape": "rectangle",
            "width": 5,
            "height": 3,
            "description": "3 complete rows of five shaded unit squares.",
            "grid": true,
            "rows": 3
          },
          "highlight": [
            "expression"
          ]
        },
        {
          "title": "Three rows of five make fifteen",
          "left": [
            {
              "id": "expression",
              "text": "five times three equals fifteen",
              "latex": "5\\times3=15",
              "spoken": "five times three equals fifteen",
              "tone": "original"
            }
          ],
          "right": [],
          "balance": null,
          "explanation": "The area is fifteen square units. Each small square is one square unit.",
          "detail": "",
          "operation": {
            "type": "simplify"
          },
          "scene": {
            "shape": "rectangle",
            "width": 5,
            "height": 3,
            "description": "A rectangle 5 units wide and 3 units high.",
            "grid": true,
            "rows": 3
          }
        }
      ]
