    {
      "id": "straight-line",
      "title": "Angles on a line",
      "label": "Angles on a line",
      "tier": "Foundation",
      "subjectArea": "geometry",
      "available": true,
      "kind": "angle-diagram",
      "initialExpression": "Angles on a line",
      "notation": {
        "latex": "110^{\\circ}+?=180^{\\circ}",
        "spoken": "Angles on a line"
      },
      "objective": "Use a straight angle to find a missing adjacent angle.",
      "prerequisites": [
        "Count small quantities and read the mathematical symbols used here."
      ],
      "curriculum": [
        {
          "provider": "AQA",
          "reference": "G3",
          "title": "GCSE Mathematics 8300 — Geometry and Measures",
          "url": "https://www.aqa.org.uk/subjects/mathematics/gcse/mathematics-8300/specification/subject-content/3.4-geometry-and-measures"
        }
      ],
      "tutorNotes": {
        "observe": "Pause after each change. Ask the student to explain the picture before continuing.",
        "misconception": "Calling adjacent angles on a straight line complementary; they sum to 180, not 90.",
        "checkQuestion": "Why must the two angles add to one hundred and eighty degrees?"
      },
      "model": {
        "total": 180,
        "angles": [
          110,
          70
        ]
      },
      "steps": [
        {
          "title": "A straight angle is half a turn",
          "left": [
            {
              "id": "expression",
              "text": "one hundred and eighty degrees",
              "latex": "180^{\\circ}",
              "spoken": "one hundred and eighty degrees",
              "tone": "original"
            }
          ],
          "right": [],
          "balance": null,
          "explanation": "Angles meeting on this straight line fill a half turn.",
          "detail": "",
          "operation": {
            "type": "show"
          },
          "scene": {
            "total": 180,
            "sectors": [
              {
                "id": "whole",
                "start": 0,
                "end": 180,
                "known": true,
                "tone": "original"
              }
            ],
            "description": "A half-turn sector measuring one hundred and eighty degrees."
          }
        },
        {
          "title": "Show the known angle",
          "left": [
            {
              "id": "expression",
              "text": "one hundred and ten degrees plus unknown equals one hundred and eighty degrees",
              "latex": "110^{\\circ}+?=180^{\\circ}",
              "spoken": "one hundred and ten degrees plus unknown equals one hundred and eighty degrees",
              "tone": "original"
            }
          ],
          "right": [],
          "balance": null,
          "explanation": "The blue angle is one hundred and ten degrees. The purple angle fills the rest.",
          "detail": "",
          "operation": {
            "type": "replace"
          },
          "scene": {
            "total": 180,
            "sectors": [
              {
                "id": "known",
                "start": 0,
                "end": 110,
                "known": true,
                "tone": "original"
              },
              {
                "id": "missing",
                "start": 110,
                "end": 180,
                "known": false,
                "tone": "operation"
              }
            ],
            "description": "Adjacent sectors of one hundred and ten degrees and an unknown angle fill the straight angle."
          }
        },
        {
          "title": "Find the rest of the half turn",
          "left": [
            {
              "id": "expression",
              "text": "one hundred and eighty minus one hundred and ten equals seventy degrees",
              "latex": "180^{\\circ}-110^{\\circ}=70^{\\circ}",
              "spoken": "one hundred and eighty minus one hundred and ten equals seventy degrees",
              "tone": "original"
            }
          ],
          "right": [],
          "balance": null,
          "explanation": "Subtract the known angle from the straight angle. The missing angle is seventy degrees.",
          "detail": "",
          "operation": {
            "type": "simplify"
          },
          "scene": {
            "total": 180,
            "sectors": [
              {
                "id": "known",
                "start": 0,
                "end": 110,
                "known": true,
                "tone": "original"
              },
              {
                "id": "missing",
                "start": 110,
                "end": 180,
                "known": true,
                "tone": "operation"
              }
            ],
            "description": "The two adjacent angles measure one hundred and ten and seventy degrees."
          },
          "highlight": [
            "expression"
          ]
        }
      ]
    },
    {
      "id": "rectangle-area",
