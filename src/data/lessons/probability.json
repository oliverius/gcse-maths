    {
      "id": "probability-scale",
      "title": "Probability scale",
      "label": "Probability scale",
      "tier": "Foundation",
      "subjectArea": "probability",
      "available": true,
      "kind": "probability-scale",
      "initialExpression": "Probability scale",
      "notation": {
        "latex": "0\\leq P\\leq1",
        "spoken": "Probability scale"
      },
      "objective": "Locate impossible, unlikely, even-chance, likely and certain events on a zero-to-one scale.",
      "prerequisites": [
        "Count small quantities and read the mathematical symbols used here."
      ],
      "curriculum": [
        {
          "provider": "Pearson Edexcel",
          "reference": "P3",
          "title": "GCSE Mathematics 1MA1 — Probability",
          "url": "https://qualifications.pearson.com/content/dam/pdf/GCSE/mathematics/2015/specification-and-sample-assesment/gcse-maths-2015-specification.pdf#page=23"
        }
      ],
      "tutorNotes": {
        "observe": "Pause after each change. Ask the student to explain the picture before continuing.",
        "misconception": "Likely means certain, or unlikely means impossible.",
        "checkQuestion": "What is the difference between likely and certain?"
      },
      "model": {},
      "steps": [
        {
          "title": "Impossible",
          "left": [
            {
              "id": "expression",
              "text": "Impossible",
              "latex": "0",
              "spoken": "Impossible",
              "tone": "original"
            }
          ],
          "right": [],
          "balance": null,
          "explanation": "There are no pink counters in a bag containing only blue and gold counters.",
          "detail": "",
          "operation": {
            "type": "show"
          },
          "scene": {
            "probability": 0,
            "description": "The marker is at probability 0: impossible."
          }
        },
        {
          "title": "Unlikely",
          "left": [
            {
              "id": "expression",
              "text": "Unlikely",
              "latex": "\\frac{{{gold}}}{{{total}}}",
              "spoken": "Unlikely",
              "tone": "original"
            }
          ],
          "right": [],
          "balance": null,
          "explanation": "{{gold|Words}} gold counter{{gold|s}} among {{total|words}} equally likely counters give{{gold|verbS}} a {{gold|words}}-in-{{total|words}} chance.",
          "detail": "",
          "operation": {
            "type": "move"
          },
          "scene": {
            "probability": {
              "$value": "low"
            },
            "description": "The marker is at probability {{low}}: unlikely."
          },
          "highlight": [
            "expression"
          ]
        },
        {
          "title": "Even chance",
          "left": [
            {
              "id": "expression",
              "text": "Even chance",
              "latex": "\\frac{1}{2}",
              "spoken": "Even chance",
              "tone": "original"
            }
          ],
          "right": [],
          "balance": null,
          "explanation": "A fair coin has two equally likely sides. Heads has an even chance.",
          "detail": "",
          "operation": {
            "type": "move"
          },
          "scene": {
            "probability": 0.5,
            "description": "The marker is at probability 0.5: even chance."
          },
          "highlight": [
            "expression"
          ]
        },
        {
          "title": "Likely",
          "left": [
            {
              "id": "expression",
              "text": "Likely",
              "latex": "\\frac{{{blue}}}{{{total}}}",
              "spoken": "Likely",
              "tone": "original"
            }
          ],
          "right": [],
          "balance": null,
          "explanation": "{{blue|Words}} blue counter{{blue|s}} among {{total|words}} equally likely counters give{{blue|verbS}} a {{blue|words}}-in-{{total|words}} chance.",
          "detail": "",
          "operation": {
            "type": "move"
          },
          "scene": {
            "probability": {
              "$value": "high"
            },
            "description": "The marker is at probability {{high}}: likely."
          },
          "highlight": [
            "expression"
          ]
        },
        {
          "title": "Certain",
          "left": [
            {
              "id": "expression",
              "text": "Certain",
              "latex": "1",
              "spoken": "Certain",
              "tone": "original"
            }
          ],
          "right": [],
          "balance": null,
          "explanation": "A bag containing only blue and gold counters must give blue or gold.",
          "detail": "",
          "operation": {
            "type": "move"
          },
          "scene": {
            "probability": 1,
            "description": "The marker is at probability 1: certain."
          },
          "highlight": [
            "expression"
          ]
        }
      ],
      "parameters": {
        "blue": {
          "min": 2,
          "max": 5
        },
        "gold": {
          "min": 1,
          "max": 4
        }
      },
      "derived": {
        "total": {
          "add": [
            "blue",
            "gold"
          ]
        },
        "low": {
          "divide": [
            "gold",
            {
              "add": [
                "blue",
                "gold"
              ]
            }
          ]
        },
        "high": {
          "divide": [
            "blue",
            {
              "add": [
                "blue",
                "gold"
              ]
            }
          ]
        }
      },
      "constraints": [
        {
          "test": {
            "less": [
              "gold",
              "blue"
            ]
          },
          "message": "Keep gold unlikely and blue likely."
        }
      ]
