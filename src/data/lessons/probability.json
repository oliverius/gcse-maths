{
  "id": "probability",
  "title": "Probability",
  "lessons": [
    {
      "id": "equally-likely",
      "title": "Equally likely outcomes",
      "label": "Equally likely outcomes",
      "tier": "Foundation",
      "subjectArea": "probability",
      "available": true,
      "kind": "counter-groups",
      "initialExpression": "Equally likely outcomes",
      "notation": {
        "latex": "P(\\text{blue})",
        "spoken": "Equally likely outcomes"
      },
      "objective": "Count equally likely favourable outcomes out of all possible outcomes.",
      "prerequisites": [
        "Count small quantities and read the mathematical symbols used here."
      ],
      "curriculum": [
        {
          "provider": "Pearson Edexcel",
          "reference": "P2, P7",
          "title": "GCSE Mathematics 1MA1 — Probability",
          "url": "https://qualifications.pearson.com/content/dam/pdf/GCSE/mathematics/2015/specification-and-sample-assesment/gcse-maths-2015-specification.pdf#page=23"
        }
      ],
      "tutorNotes": {
        "observe": "Pause after each change. Ask the student to explain the picture before continuing.",
        "misconception": "Dividing by only the unwanted outcomes rather than all outcomes.",
        "checkQuestion": "Why is the denominator {{total|words}} rather than {{gold|words}}?"
      },
      "model": {
        "favourable": {
          "$value": "blue"
        },
        "total": {
          "$value": "total"
        }
      },
      "steps": [
        {
          "title": "{{total|Words}} equally likely counters",
          "left": [
            {
              "id": "expression",
              "text": "{{total|words}} outcomes",
              "latex": "{{total}}\\text{ outcomes}",
              "spoken": "{{total|words}} outcomes",
              "tone": "original"
            }
          ],
          "right": [],
          "balance": null,
          "explanation": "Mix {{total|words}} same-sized counters. Choose one without looking: each counter is equally likely.",
          "detail": "",
          "operation": {
            "type": "show"
          },
          "scene": {
            "description": "{{blue|Words}} identical counter{{blue|s}} marked B for blue and {{gold|words}} marked G for gold.",
            "caption": "B = blue · G = gold · each counter is equally likely.",
            "groups": [
              {
                "id": "bag",
                "label": "One mixed bag",
                "items": [
                  {
                    "$repeat": {
                      "count": "blue",
                      "as": "i",
                      "item": {
                        "id": "blue-{{i}}",
                        "value": 1,
                        "latex": "\\mathrm{B}",
                        "spoken": "blue counter",
                        "tone": "original",
                        "highlight": false,
                        "category": "blue",
                        "shape": "circle"
                      },
                      "derived": {},
                      "start": 0
                    }
                  },
                  {
                    "$repeat": {
                      "count": "gold",
                      "as": "j",
                      "item": {
                        "id": "gold-{{j}}",
                        "value": 1,
                        "latex": "\\mathrm{G}",
                        "spoken": "gold counter",
                        "tone": "operation",
                        "highlight": false,
                        "category": "gold",
                        "shape": "circle"
                      },
                      "derived": {},
                      "start": 0
                    }
                  }
                ]
              }
            ]
          }
        },
        {
          "title": "Count the blue outcomes",
          "left": [
            {
              "id": "expression",
              "text": "{{blue|words}} blue out of {{total|words}}",
              "latex": "{{blue}}\\text{ blue out of }{{total}}",
              "spoken": "{{blue|words}} blue out of {{total|words}}",
              "tone": "original"
            }
          ],
          "right": [],
          "balance": null,
          "explanation": {
            "$if": {
              "test": {
                "equal": [
                  "blue",
                  1
                ]
              },
              "then": "One of the {{total|words}} counters is blue. This is the favourable outcome for blue.",
              "else": "{{blue|Words}} of the {{total|words}} counters are blue. These are the favourable outcomes for blue."
            }
          },
          "detail": "",
          "operation": {
            "type": "highlight"
          },
          "scene": {
            "description": "{{blue|Words}} identical counter{{blue|s}} marked B for blue and {{gold|words}} marked G for gold.",
            "caption": "B = blue · G = gold · each counter is equally likely.",
            "groups": [
              {
                "id": "bag",
                "label": "One mixed bag",
                "items": [
                  {
                    "$repeat": {
                      "count": "blue",
                      "as": "i",
                      "item": {
                        "id": "blue-{{i}}",
                        "value": 1,
                        "latex": "\\mathrm{B}",
                        "spoken": "blue counter",
                        "tone": "original",
                        "highlight": true,
                        "category": "blue",
                        "shape": "circle"
                      },
                      "derived": {},
                      "start": 0
                    }
                  },
                  {
                    "$repeat": {
                      "count": "gold",
                      "as": "j",
                      "item": {
                        "id": "gold-{{j}}",
                        "value": 1,
                        "latex": "\\mathrm{G}",
                        "spoken": "gold counter",
                        "tone": "operation",
                        "highlight": false,
                        "category": "gold",
                        "shape": "circle"
                      },
                      "derived": {},
                      "start": 0
                    }
                  }
                ]
              }
            ]
          },
          "highlight": [
            "expression"
          ]
        },
        {
          "title": "Write favourable over total",
          "left": [
            {
              "id": "expression",
              "text": {
                "$join": {
                  "items": [
                    "probability of blue equals ",
                    {
                      "$if": {
                        "test": {
                          "equal": [
                            "blue",
                            1
                          ]
                        },
                        "then": "{{blue|words}} {{total|fraction}}",
                        "else": "{{blue|words}} {{total|fractions}}"
                      }
                    }
                  ],
                  "separator": ""
                }
              },
              "latex": "P(\\text{blue})=\\frac{{{blue}}}{{{total}}}",
              "spoken": {
                "$join": {
                  "items": [
                    "probability of blue equals ",
                    {
                      "$if": {
                        "test": {
                          "equal": [
                            "blue",
                            1
                          ]
                        },
                        "then": "{{blue|words}} {{total|fraction}}",
                        "else": "{{blue|words}} {{total|fractions}}"
                      }
                    }
                  ],
                  "separator": ""
                }
              },
              "tone": "original"
            }
          ],
          "right": [],
          "balance": null,
          "explanation": "Put the number of blue counters over the total number of counters.",
          "detail": "",
          "operation": {
            "type": "simplify"
          },
          "scene": {
            "description": "{{blue|Words}} identical counter{{blue|s}} marked B for blue and {{gold|words}} marked G for gold.",
            "caption": "B = blue · G = gold · each counter is equally likely.",
            "groups": [
              {
                "id": "bag",
                "label": "One mixed bag",
                "items": [
                  {
                    "$repeat": {
                      "count": "blue",
                      "as": "i",
                      "item": {
                        "id": "blue-{{i}}",
                        "value": 1,
                        "latex": "\\mathrm{B}",
                        "spoken": "blue counter",
                        "tone": "original",
                        "highlight": true,
                        "category": "blue",
                        "shape": "circle"
                      },
                      "derived": {},
                      "start": 0
                    }
                  },
                  {
                    "$repeat": {
                      "count": "gold",
                      "as": "j",
                      "item": {
                        "id": "gold-{{j}}",
                        "value": 1,
                        "latex": "\\mathrm{G}",
                        "spoken": "gold counter",
                        "tone": "operation",
                        "highlight": false,
                        "category": "gold",
                        "shape": "circle"
                      },
                      "derived": {},
                      "start": 0
                    }
                  }
                ]
              }
            ]
          },
          "highlight": [
            "expression"
          ]
        }
      ],
      "parameters": {
        "blue": {
          "min": 1,
          "max": 5
        },
        "gold": {
          "min": 1,
          "max": 5
        }
      },
      "derived": {
        "total": {
          "add": [
            "blue",
            "gold"
          ]
        }
      }
    },
    {
      "id": "complement",
