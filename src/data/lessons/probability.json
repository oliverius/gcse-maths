                  "items": [
                    "probability of not blue equals ",
                    {
                      "$if": {
                        "test": {
                          "equal": [
                            "gold",
                            1
                          ]
                        },
                        "then": "{{gold|words}} {{total|fraction}}",
                        "else": "{{gold|words}} {{total|fractions}}"
                      }
                    }
                  ],
                  "separator": ""
                }
              },
              "latex": "P(\\text{not blue})=\\frac{{{gold}}}{{{total}}}",
              "spoken": {
                "$join": {
                  "items": [
                    "probability of not blue equals ",
                    {
                      "$if": {
                        "test": {
                          "equal": [
                            "gold",
