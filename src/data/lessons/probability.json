              "then": "Only one counter is not blue. Every counter is either blue or not blue.",
              "else": "{{gold|Words}} counters are not blue. Every counter is either blue or not blue."
            }
          },
          "detail": "",
          "operation": {
            "type": "highlight"
          },
          "scene": {
            "description": "{{blue|Words}} identical counter{{blue|s}} marked B for blue and {{gold|words}} marked G for gold.",
            "caption": "B = blue · G = gold · each counter is equally likely.",
            "groups": [
              {
                "id": "bag",
                "label": "One mixed bag",
                "items": [
                  {
                    "$repeat": {
