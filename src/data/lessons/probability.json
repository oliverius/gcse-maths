        }
      ],
      "tutorNotes": {
        "observe": "Pause after each change. Ask the student to explain the picture before continuing.",
        "misconception": "Forgetting that the complement includes every other possible outcome.",
        "checkQuestion": "Could one counter be both blue and not blue?"
      },
      "model": {
        "favourable": {
          "$value": "blue"
